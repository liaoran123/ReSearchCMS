package files

import (
	"fmt"
	"os"
	"path/filepath"
	"regexp"
	"researchCms/pool"
	"researchCms/tables"
	"strings"
	"sync"
	"time"
)

// 全局Pool实例
var globalPool *pool.Pool

// 全局正则表达式，用于句子分解
// 包括：句号(。.)、感叹号(！!)、问号(？?)、分号(；;)、换行符
var sentenceRegex = regexp.MustCompile(`[。.!?？！；;\n]+`)

func init() {
	// 初始化全局Pool，数据库插入属于IO密集型任务，使用专门的IO Pool
	globalPool = pool.NewPoolForIO()
}

// TraversePathAndReadFiles 根据给定路径遍历读取所有文本文件内容
// 参数 rootPath: 要遍历的根目录路径
// 返回值: 遍历过程中发生的错误
func TraversePathAndReadFiles(rootPath string) error {
	err := filepath.Walk(rootPath,
		func(path string, info os.FileInfo, err error) error {
			if err != nil {
				return err
			}
			// 插入目录到数据库
			currentID, err := tables.Dir.Insert(&map[string]any{
				"name": info.Name(),
				"url":  path,
				"ext":  filepath.Ext(path), //文件后缀
			})
			if err != nil {
				return fmt.Errorf("插入目录失败 '%s': %w", path, err)
			}

			// 跳过目录，只处理文件
			if info.IsDir() {
				return nil
			}

			// 读取文件内容
			content, readErr := ReadFileContent(path)
			if readErr != nil {
				return fmt.Errorf("读取文件失败 '%s': %w", path, readErr)
			}

			// 调用AddArticle并检查错误
			if err := AddArticle(currentID, info.Name(), content); err != nil {
				return fmt.Errorf("处理文件 '%s' 失败: %w", path, err)
			}

			return nil
		})

	return err
}

// ArticleError 文章处理错误，包含详细的错误信息
type ArticleError struct {
	MID      int    // 目录ID
	Title    string // 文章标题
	Sentence string // 失败的句子内容
	Index    int    // 句子索引
	Err      error  // 原始错误
}

// Error 返回格式化的错误信息
func (e *ArticleError) Error() string {
	return fmt.Sprintf("目录ID %d, 标题 '%s', 句子 %d: %v (内容: '%s')",
		e.MID, e.Title, e.Index, e.Err, e.Sentence)
}

// processSentence 处理单个句子，将其插入到数据库
// 参数 mid: 目录ID
// 参数 title: 文章标题
// 参数 sentence: 要处理的句子内容
// 参数 index: 句子索引
// 参数 wg: 等待组，用于同步任务
// 参数 mu: 互斥锁，用于保护共享资源
// 参数 errs: 错误切片，用于收集处理过程中的错误
func processSentence(mid int, title, sentence string, index int,
	wg *sync.WaitGroup, mu *sync.Mutex, errs *[]error) {
	defer wg.Done()

	// 插入文章到数据库
	_, err := tables.Article.Insert(&map[string]any{
		"mid":     mid, //文章目录ID
		"title":   title,
		"content": sentence,
	})

	if err != nil {
		mu.Lock()
		// 创建详细的错误信息
		errInfo := &ArticleError{
			MID:      mid,
			Title:    title,
			Sentence: sentence,
			Index:    index,
			Err:      err,
		}
		*errs = append(*errs, errInfo)
		fmt.Println("插入文章失败:", errInfo)
		mu.Unlock()
	}
}

// AddArticle 将文章内容按句子分割并插入到数据库
// 参数 mid: 目录ID，用于关联文章和目录
// 参数 title: 文章标题
// 参数 content: 文章完整内容
// 返回值: 处理过程中发生的错误
func AddArticle(mid int, title, content string) error {
	// 记录开始时间
	startTime := time.Now()

	// 使用全局正则表达式分割句子
	parts := sentenceRegex.Split(content, -1)

	var wg sync.WaitGroup
	var mu sync.Mutex
	var errs []error
	var sentenceIndex int
	var totalSentences int

	// 过滤空字符串和纯空白字符串，并处理每个句子
	for _, part := range parts {
		trimmed := strings.TrimSpace(part)
		if trimmed != "" {
			totalSentences++
			wg.Add(1)
			// 捕获当前循环变量和索引
			currentIndex := sentenceIndex
			sentence := trimmed
			sentenceIndex++
			// 提交任务到全局Pool
			globalPool.Submit(func() {
				processSentence(mid, title, sentence, currentIndex, &wg, &mu, &errs)
			})
		}
	}

	// 等待所有任务完成
	wg.Wait()

	// 计算处理时间
	duration := time.Since(startTime)

	// 计算成功和失败的任务数量
	successCount := totalSentences - len(errs)
	failureCount := len(errs)

	// 打印性能统计信息
	fmt.Printf("文章处理完成 | 目录ID: %d | 标题: '%s' | ", mid, title)
	fmt.Printf("总句子数: %d | 成功: %d | 失败: %d | ", totalSentences, successCount, failureCount)
	fmt.Printf("耗时: %v\n", duration)

	// 返回聚合错误或nil
	if len(errs) > 0 {
		return fmt.Errorf("共 %d 个句子插入失败，第一个错误: %w", len(errs), errs[0])
	}
	return nil
}

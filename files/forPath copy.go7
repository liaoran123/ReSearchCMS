package files

import (
	"ReSearch/db"
	"ReSearch/pool"
	"fmt"
	"os"
	"path/filepath"
	"regexp"
	"strings"
	"sync"
	"time"

	"github.com/liaoran123/sfsDb/storage"
	"github.com/liaoran123/sfsDb/util"
)

// 全局Pool实例
var globalPool *pool.Pool

var batch storage.Batch

func init() {
	// 初始化全局Pool，数据库插入属于IO密集型任务，使用专门的IO Pool
	globalPool = pool.NewPoolForIO()
	//batch = db.Store.GetBatch()
}

// 定义中英文句子分隔符的正则表达式
var re = regexp.MustCompile(`[。.!?？！；;\n]+`)
var mu sync.Mutex

// TraversePathAndReadFiles 根据给定路径遍历读取所有文本文件内容
func TraversePathAndReadFiles(rootPath string) error {
	btime := time.Now()
	//打印btime
	fmt.Printf("开始遍历路径 %s 时间: %v\n", rootPath, btime)
	batch = db.Store.GetBatch()
	defer db.Store.WriteBatch(batch, true)
	var currentID int
	var err error
	var content string
	err = filepath.Walk(rootPath,
		func(path string, info os.FileInfo, err error) error {
			if err != nil {
				return err
			}
			//检测目录是否存在
			dirurliter := db.Tables["dir"].Search(&map[string]any{
				"url": path,
			})
			defer dirurliter.Release()
			if dirurliter.Exist() {
				record := dirurliter.GetRecords(true, 1).Select("id")
				if len(record) > 0 {
					currentID = record[0]["id"].(int)
				}
			} else {
				mu.Lock()
				// 插入目录到数据库
				currentID, err = db.Tables["dir"].Insert(&map[string]any{
					"name": info.Name(),
					"url":  path,
					"ext":  filepath.Ext(path), //文件后缀
				}, batch)
				if err != nil {
					fmt.Printf("插入目录 %s 失败: %v\n", path, err)
					return err
				}
				mu.Unlock()
			}

			// 读取文件内容
			if !info.IsDir() {
				content, err = ReadFileContent(path)
				if err != nil {
					return err
				}
			} else {
				content = ""
			}
			name := info.Name()
			//删除后缀
			name = strings.TrimSuffix(name, filepath.Ext(name))
			content = "<" + name + ">\n" + content //可以使用"<"+关键词,指定搜索标题
			// 调用AddArticle并检查错误
			if err := AddArticle(currentID, content); err != nil {
				fmt.Printf("插入文章 %s 失败: %v\n", name, err)
				return err
			}
			return nil
		})

	endTime := time.Now()
	//打印endTime
	fmt.Printf("遍历路径 %s 结束时间: %v\n", rootPath, endTime)
	// 打印耗时
	fmt.Printf("遍历路径 %s 耗时: %v\n", rootPath, time.Since(btime))
	// 不要停止线程池，保持其运行状态
	//globalPool.Stop()
	return err
}

func AddArticle(mid int, content string) error {
	// 定义中英文句子分隔符的正则表达式
	parts := re.Split(content, -1)
	var wg sync.WaitGroup

	var errChan = make(chan error, len(parts))
	// 过滤空字符串和纯空白字符串
	secNo := 0
	for _, part := range parts {
		trimmed := strings.TrimSpace(part)
		if trimmed == "" {
			continue
		}
		mu.Lock()
		secNo++
		currentSecNo := secNo
		mu.Unlock()
		wg.Add(1) //+1，外面加1
		// 捕获当前循环变量，多线程内所有数据必须使用私有变量，不能使用共享变量。共享变量会导致数据竞争。
		localTrimmed := trimmed
		localSecNo := currentSecNo

		globalPool.Submit(func() {
			defer wg.Done() //-1，里面减1

			iter := db.Tables["senc"].Search(&map[string]any{
				"did":   mid,
				"secNo": currentSecNo,
			}, util.Equal)
			defer iter.Release()
			if iter.Exist() {
				//打印min,currentSecNo
				//fmt.Printf("min: %v, currentSecNo: %v\n", mid, currentSecNo)
				return
			} else {
				//打印min,currentSecNo
				fmt.Printf("--》min: %v, currentSecNo: %v, trimmed: %v\n", mid, currentSecNo, localTrimmed)
			}

			iter1 := db.Tables["senc"].Search(&map[string]any{
				"content": localTrimmed,
			})
			defer iter1.Release()
			if iter1.Exist() {
				//打印min,currentSecNo
				//fmt.Printf("min: %v, currentSecNo: %v\n", mid, currentSecNo)
				return
			} else {
				//打印localTrimmed
				fmt.Printf("min: %v, currentSecNo: %v, trimmed: %v\n", mid, currentSecNo, localTrimmed)
			}

			// 插入文章到数据库
			//fmt.Printf("trimmed: %v\n", localTrimmed)
			mu.Lock() //加锁，那么和不使用多线程效果是一样的。看来不支持并发批量写入。
			_, err := db.Tables["senc"].Insert(&map[string]any{
				"did":     mid,        //文章目录ID
				"secNo":   localSecNo, //文章句子序号
				"content": localTrimmed,
			}, batch)
			if err != nil {
				fmt.Println("插入文章失败:", err)
				errChan <- err
			}
			if batch.Len() >= 1000 {
				// 提交批量操作
				err = db.Store.WriteBatch(batch, false)
				if err != nil {
					fmt.Println("写入批量操作失败:", err)
					errChan <- err
				}
			}
			mu.Unlock()
		})

	}
	// 等待所有任务完成
	wg.Wait()
	close(errChan)
	// 检查是否有错误
	for err := range errChan {
		return err
	}
	return nil
}

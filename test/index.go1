package test

import (
	"bytes"
	"strings"
)

const SPLIT = "-" //分隔符
// ------------------------------------------
/*
// 基础接口
type BaseIndex interface {
	Prefix() string
	Join(fieldsBytes *map[string][]byte, fields []string, pfx ...string) []byte
}*/

// ------------------------------------------
// 主键接口
type Primary interface {
	JoinID(fieldsBytes *map[string][]byte, fields []string, pfx ...string) []byte
	//转义
	//Quote(value []byte) []byte
}

// 普通索引接口
type NlIndex interface {
	Prefix() string
	Join(fieldsBytes *map[string][]byte, fields []string, pfx ...string) []byte
}
type FullText interface {
	Join(fieldsBytes *map[string][]byte, fields []string, pfx ...string) [][]byte
	// 切词
	Tokenize(value string) []string
}
type NoIndex interface {
	Prefix() string
}

// ------------------------------------------
// 将字段对应的字节值拼接起来，用SPLIT分隔
func Join(fieldsBytes *map[string][]byte, fields []string, pfx ...string) []byte {
	var indexValue []byte
	for i, fit := range fields {
		if v, ok := (*fieldsBytes)[fit]; !ok {
			return nil
		} else {
			indexValue = append(indexValue, v...)
			if i < len(fields)-1 {
				indexValue = append(indexValue, SPLIT...)
			}
		}
	}
	//pfx := fieldIndexKind[0].indexKind.Name()
	Pfx := ""
	if len(pfx) > 0 {
		Pfx = strings.Join(pfx, SPLIT)
	}
	if Pfx != "" {
		indexValue = bytes.Join([][]byte{[]byte(Pfx), indexValue}, []byte(SPLIT))
	}
	return indexValue
}

// ------------------------------------------
// 创建一个主键
type PrimaryKey struct {
}

func (p *PrimaryKey) Prefix() string {
	return "primary"
}
func (p *PrimaryKey) JoinID(fieldsBytes *map[string][]byte, fields []string, pfx ...string) []byte {
	return Join(fieldsBytes, fields, pfx...)
}

type NormalIndex struct {
	value []byte
}

func (n *NormalIndex) Prefix() string {
	return "normal"
}
func (n *NormalIndex) Join(fieldsBytes *map[string][]byte, fields []string, pfx ...string) []byte {
	return Join(fieldsBytes, fields, pfx...)
}

type FullTextIndex struct {
	value []byte
}

func (f *FullTextIndex) Prefix() string {
	return "fulltext"
}
func (f *FullTextIndex) Join(fieldsBytes *map[string][]byte, fields []string, pfx ...string) [][]byte {
	var r [][]byte

	var fieldValue []byte
	var exists bool
	var curpfx [][]byte
	//curpfx = append(curpfx, fullTextPrefix)
	ftpxf := []byte(nil)
	if len(pfx) > 0 {
		ftpxf = []byte(strings.Join(pfx, SPLIT))
	}
	var isnil bool
	for _, fit := range fields {
		// 获取字段的实际值
		fieldValue, exists = (*fieldsBytes)[fit]
		if !exists {
			continue // 跳过不存在的字段
		}
		//var isFullTextField bool
		var fullTextIndex *FullTextIndex
		if fullTextIndex != nil {
			fullTextIndex = f
		}
		//组合全文索引时，全文索引字段和普通索引字段组合，需要判断那个字段是全文索引字段
		for _, fit := range fields {
			if _, ok := fit.(*FullTextIndex); ok {
				fullTextIndex = fit.(*FullTextIndex)
				//ftpxf = []byte(fit.indexKind.Name())
				break
			}
		}
		switch fullTextIndex != nil {
		case true: // 全文索引字段
			// 将字段值转换为字符串，全文索引只支持字符串
			fieldStr := string(fieldValue)
			// 对字段值进行分词
			/*
				//判断是否是FullText接口
				if _, ok := fit.indexKind.(FullText); !ok {
					continue
				}*/
			tokens := fullTextIndex.Tokenize(fieldStr)
			//tokens := GetFullTextToken(fieldStr, ftlen)
			for _, token := range tokens {
				if token == "" {
					continue
				}
				curpfx = append(curpfx, bytes.Join([][]byte{ftpxf, []byte(token)}, []byte(SPLIT)))
				//curpfx = append(curpfx, []byte(token))
			}
		case false: // 普通索引字段
			curpfx = append(curpfx, bytes.Join([][]byte{ftpxf, fieldValue}, []byte(SPLIT)))
			//curpfx = append(curpfx, fieldValue)
		}
		//返回结果是否为空
		isnil = r == nil
		switch isnil {
		case true:
			//r = append(r, append([][]byte{}, ftpxf...)...)
			r = append(r, append([][]byte{}, curpfx...)...)
		case false: // 拼接当前索引前缀到结果中,一对多和多对一关系，多对多已经过滤，属于非法。
			for i, idx := range r {
				for _, pfx := range curpfx {
					var tidx []byte
					tidx = append(tidx, append([]byte{}, idx...)...)
					var tpfx []byte
					tpfx = append(tpfx, append([]byte{}, pfx...)...)
					tidx = bytes.Join([][]byte{tidx, tpfx}, []byte{})
					r[i] = tidx
				}
			}
		}
		curpfx = curpfx[:0]
		ftpxf = ftpxf[:0]
	}
	return r
}
func (f *FullTextIndex) Tokenize(value string) []string {
	return nil
}

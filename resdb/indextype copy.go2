package resdb

import "strings"

// IndexKind 定义索引类型枚举
type IndexKind int

const (
	Primary  IndexKind = iota + 1 // 主键
	nlIndex                       // 普通索引
	FullText                      // 全文索引
	NoIndex                       // 无索引
)

// 主键结构体
type Indexs struct {
	Kind   IndexKind // 索引类型
	Fields []string  // 主键字段列表，单主键长度为1，组合主键长度>1
	Prefix string    // 索引前缀
}

// 实现 IndexType 接口
func (pk *Indexs) Name() string {
	var r strings.Builder
	for _, field := range pk.Fields {
		r.WriteString(field + ",")
	}
	return r.String()
}

func (pk *Indexs) IsComposite() bool {
	return len(pk.Fields) > 1
}

package resdb

import (
	"bytes"
	"fmt"
	"slices"
	"strings"
)

// ------------------------------------------

// 定义索引类型接口
type FieldKind interface {
	Name() string
}

// 没有索引
type FieldNoIndex struct{}

func (n *FieldNoIndex) Name() string {
	return "NoIndex"
}

// 主键索引
type FieldPrimary struct{}

func (p *FieldPrimary) Name() string {
	return "Primary"
}

// 普通索引
type FieldNormalIndex struct{}

func (i *FieldNormalIndex) Name() string {
	return "Normal"
}

// 全文索引
// FullTextIndex 分别属于两个接口:
// 1. IndexKind 接口，用于索引类型判断
// 2. FullText 接口，用于全文索引分词
type FieldFullTextIndex struct {
	ftlen uint8 // 全文索引分词长度限制3--11之间
}

func FullTextIndexNew() *FieldFullTextIndex {
	return &FieldFullTextIndex{ftlen: uint8(5)}
}
func (i *FieldFullTextIndex) Set(ftlen int) error {
	if ftlen < 3 || ftlen > 11 {
		return fmt.Errorf("全文索引分词长度限制3--11之间")
	}
	i.ftlen = uint8(ftlen)
	return nil
}

// 将方法接收者类型从FullTextIndex更新为FieldFullTextIndex
func (i *FieldFullTextIndex) GetLen() int {
	if i.ftlen == 0 {
		return 5
	}
	return int(i.ftlen)
}
func (i *FieldFullTextIndex) Name() string {
	return "FullText"
}
func (i *FieldFullTextIndex) Tokenize(nr string) (tokens []string) {
	var knr string //, fid
	var ml, cl int
	var r, idxstr []rune
	r = []rune(nr)
	cl = len([]rune(nr))
	for cl > 0 {
		ml = min(cl, int(i.ftlen))
		idxstr = r[:ml]
		knr = string(idxstr)
		tokens = append(tokens, knr)
		r = r[1:]
		cl = len(r)
	}
	return
}

// ------------------------------------------

// 字段索引类型
// 每个字段可以在不同索引中定义为不同的索引类型，高度灵活
type FieldIndexKind struct {
	field     string
	fieldKind FieldKind
}

func FieldIndexKindNew(field string, kind FieldKind) *FieldIndexKind {
	return &FieldIndexKind{field: field, fieldKind: kind}
}

// 设置值
func (fit *FieldIndexKind) Set(field string, kind FieldKind) {
	fit.field = field
	fit.fieldKind = kind
}

// 获取索引类型
func (fit *FieldIndexKind) FieldKind() FieldKind {
	return fit.fieldKind
}

// 获取索引字段
func (fit *FieldIndexKind) Field() string {
	return fit.field
}

// ------------------------------------------
// 全文索引遍历分词法
func GetFullTextToken(nr string, ftlen int) (tokens []string) {
	var knr string //, fid
	var ml, cl int
	var r, idxstr []rune
	r = []rune(nr)
	cl = len([]rune(nr))
	for cl > 0 {
		ml = min(cl, ftlen)
		idxstr = r[:ml]
		knr = string(idxstr)
		tokens = append(tokens, knr)
		r = r[1:]
		cl = len(r)
	}
	return
}

// ------------------------------------------
// 组织索引值
// 组合索引值，主键和索引是一样的，但是全文索引不同。
type JoinIndexValue func(fieldsBytes *map[string][]byte, fieldIndexKind []*FieldIndexKind, pfx ...string) any

// 将字段对应的字节值拼接起来，用SPLIT分隔
func DefaultJoinIndexValue(fieldsBytes *map[string][]byte, fieldIndexKind []*FieldIndexKind, pfx ...string) any {
	var indexValue []byte
	for i, fit := range fieldIndexKind {
		if v, ok := (*fieldsBytes)[fit.field]; !ok {
			return nil
		} else {
			indexValue = append(indexValue, v...)
			if i < len(fieldIndexKind)-1 {
				indexValue = append(indexValue, SPLIT...)
			}
		}
	}
	//pfx := fieldIndexKind[0].indexKind.Name()
	Pfx := ""
	if len(pfx) > 0 {
		Pfx = strings.Join(pfx, SPLIT)
	}
	if Pfx != "" {
		indexValue = bytes.Join([][]byte{[]byte(Pfx), indexValue}, []byte(SPLIT))
	}
	return indexValue
}

// 将字段对应的字节值拼接起来，用SPLIT分隔
func DefaultJoinFullTextIndexValue(fieldsBytes *map[string][]byte, fieldIndexKind []*FieldIndexKind, pfx ...string) any {
	var r [][]byte

	var fieldValue []byte
	var exists bool
	var curpfx [][]byte
	//curpfx = append(curpfx, fullTextPrefix)
	ftpxf := []byte(nil)
	if len(pfx) > 0 {
		ftpxf = []byte(strings.Join(pfx, SPLIT))
	}
	var isnil bool
	for _, fit := range fieldIndexKind {
		// 获取字段的实际值
		fieldValue, exists = (*fieldsBytes)[fit.field]
		if !exists {
			continue // 跳过不存在的字段
		}
		//var isFullTextField bool
		var fullTextIndex *FieldFullTextIndex

		//组合全文索引时，全文索引字段和普通索引字段组合，需要判断那个字段是全文索引字段
		for _, fit := range fieldIndexKind {
			if _, ok := fit.fieldKind.(*FieldFullTextIndex); ok {
				fullTextIndex = fit.fieldKind.(*FieldFullTextIndex)
				//ftpxf = []byte(fit.fieldKind.Name())
				break
			}
		}
		switch fullTextIndex != nil {
		case true: // 全文索引字段
			// 将字段值转换为字符串，全文索引只支持字符串
			fieldStr := string(fieldValue)
			// 对字段值进行分词
			/*
				//判断是否是FullText接口
				if _, ok := fit.fieldKind.(FullText); !ok {
					continue
				}*/
			tokens := fullTextIndex.Tokenize(fieldStr)
			//tokens := GetFullTextToken(fieldStr, ftlen)
			for _, token := range tokens {
				if token == "" {
					continue
				}
				curpfx = append(curpfx, bytes.Join([][]byte{ftpxf, []byte(token)}, []byte(SPLIT)))
				//curpfx = append(curpfx, []byte(token))
			}
		case false: // 普通索引字段
			curpfx = append(curpfx, bytes.Join([][]byte{ftpxf, fieldValue}, []byte(SPLIT)))
			//curpfx = append(curpfx, fieldValue)
		}
		//返回结果是否为空
		isnil = r == nil
		switch isnil {
		case true:
			//r = append(r, append([][]byte{}, ftpxf...)...)
			r = append(r, append([][]byte{}, curpfx...)...)
		case false: // 拼接当前索引前缀到结果中,一对多和多对一关系，多对多已经过滤，属于非法。
			for i, idx := range r {
				for _, pfx := range curpfx {
					var tidx []byte
					tidx = append(tidx, append([]byte{}, idx...)...)
					var tpfx []byte
					tpfx = append(tpfx, append([]byte{}, pfx...)...)
					tidx = bytes.Join([][]byte{tidx, tpfx}, []byte{})
					r[i] = tidx
				}
			}
		}
		curpfx = curpfx[:0]
		ftpxf = ftpxf[:0]
	}
	return r
}

// ------------------------------------------
type PrimaryKey interface {
	Add(fieldIndexKind ...*FieldIndexKind)
	GetFields() []*FieldIndexKind
	ID() []byte
	Join(fieldsBytes *map[string][]byte, pfx string) []byte
	Prefix() string
	Len() int
	SetID(fieldsBytes *map[string][]byte)
}

// ------------------------------------------
// 默认主键索引
type DefaultPrimaryKey struct {
	fields []*FieldIndexKind // 主键字段列表，数组，即是支持单主键，也支持组合主键
	id     []byte
	name   string
}

func DefaultPrimaryKeyNew() *DefaultPrimaryKey {
	return &DefaultPrimaryKey{
		name: "Primary",
	}
}
func (dpk *DefaultPrimaryKey) GetFields() []*FieldIndexKind {
	return dpk.fields
}
func (dpk *DefaultPrimaryKey) Add(fieldIndexKind ...*FieldIndexKind) {
	dpk.fields = append(dpk.fields, fieldIndexKind...)
}
func (dpk *DefaultPrimaryKey) Prefix() string {
	return dpk.name
}
func (dpk *DefaultPrimaryKey) Len() int {
	return len(dpk.fields)
}
func (dpk *DefaultPrimaryKey) Join(fieldsBytes *map[string][]byte, pfx string) []byte {
	if dpk.id == nil {
		dpk.SetID(fieldsBytes)
	}
	Value := dpk.id
	dpkPfx := dpk.Prefix()
	if len(pfx) > 0 {
		dpkPfx = pfx + SPLIT + dpkPfx //+ SPLIT
	}
	Value = bytes.Join([][]byte{[]byte(dpkPfx), Value}, []byte(SPLIT))
	return Value
}
func (dpk *DefaultPrimaryKey) SetID(fieldsBytes *map[string][]byte) {
	var Value []byte
	if dpk.id == nil {
		for i, fit := range dpk.fields {
			if v, ok := (*fieldsBytes)[fit.field]; !ok {
				return
			} else {
				Value = append(Value, v...)
				if i < len(dpk.fields)-1 {
					Value = append(Value, SPLIT...)
				}
			}
		}
	}
	dpk.id = Value
}
func (dpk *DefaultPrimaryKey) ID() []byte {
	return dpk.id
}

// ------------------------------------------
// 普通索引接口
type NormalIndex interface {
	Add(fieldIndexKind ...*FieldIndexKind)
	GetFields() []*FieldIndexKind
	Join(fieldsBytes *map[string][]byte, pfx string) []byte
	Prefix() string
}

// ------------------------------------------
// 默认普通索引
type DefaultNormalIndex struct {
	fields []*FieldIndexKind
	name   string
}

func DefaultNormalIndexNew() *DefaultNormalIndex {
	return &DefaultNormalIndex{
		name: "Normal",
	}
}
func (dni *DefaultNormalIndex) Prefix() string {
	return dni.name
}
func (dni *DefaultNormalIndex) GetFields() []*FieldIndexKind {
	return dni.fields
}
func (dni *DefaultNormalIndex) Add(fieldIndexKind ...*FieldIndexKind) {
	dni.fields = append(dni.fields, fieldIndexKind...)
}
func (dni *DefaultNormalIndex) Join(fieldsBytes *map[string][]byte, pfx string) []byte {
	var Value []byte
	for i, fit := range dni.fields {
		if v, ok := (*fieldsBytes)[fit.field]; !ok {
			return nil
		} else {
			Value = append(Value, v...)
			if i < len(dni.fields)-1 {
				Value = append(Value, SPLIT...)
			}
		}
	}
	dniPfx := dni.Prefix()
	if len(pfx) > 0 {
		dniPfx = pfx + SPLIT + dniPfx // + SPLIT
	}
	Value = bytes.Join([][]byte{[]byte(dniPfx), Value}, []byte(SPLIT))
	return Value
}

// ------------------------------------------
// 全文索引接口
type FullTextIndex interface {
	Add(fieldIndexKind ...*FieldIndexKind)
	GetFields() []*FieldIndexKind
	Join(fieldsBytes *map[string][]byte, pfx string) [][]byte
	Prefix() string
}

// ------------------------------------------
// 全文索引字段类型
type FieldFullTextIndex struct {
	Fields string // 全文索引字段名
	Len    int    // 全文索引字段长度
}

// 默认全文索引
type DefaultFullTextIndex struct {
	fields   []*FieldIndexKind
	ftfields []FieldFullTextIndex
	name     string
}

func DefaultFullTextIndexNew() *DefaultFullTextIndex {
	return &DefaultFullTextIndex{
		name: "FullText",
	}
}
func (dfi *DefaultFullTextIndex) GetFields() []*FieldIndexKind {
	return dfi.fields
}
func (dfi *DefaultFullTextIndex) Prefix() string {
	return dfi.name
}
func (dfi *DefaultFullTextIndex) Add(fieldIndexKind ...*FieldIndexKind) {
	dfi.fields = append(dfi.fields, fieldIndexKind...)
}
func (dfi *DefaultFullTextIndex) Join(fieldsBytes *map[string][]byte, pfx string) [][]byte {
	var r [][]byte

	var fieldValue []byte
	var exists bool
	var curpfx [][]byte
	//curpfx = append(curpfx, fullTextPrefix)
	ftpxf := []byte(nil)
	if len(pfx) > 0 {
		ftpxf = []byte(pfx + SPLIT + dfi.Prefix()) // + SPLIT)
	}
	var isnil bool
	for _, fit := range dfi.fields {
		// 获取字段的实际值
		fieldValue, exists = (*fieldsBytes)[fit.field]
		if !exists {
			continue // 跳过不存在的字段
		}
		//var isFullTextField bool
		var fullTextIndex *FieldFullTextIndex

		//组合全文索引时，全文索引字段和普通索引字段组合，需要判断那个字段是全文索引字段
		for _, fit := range dfi.fields {
			if _, ok := fit.fieldKind.(*FieldFullTextIndex); ok {
				fullTextIndex = fit.fieldKind.(*FieldFullTextIndex)
				//ftpxf = []byte(fit.fieldKind.Name())
				break
			}
		}
		switch fullTextIndex != nil {
		case true: // 全文索引字段
			// 将字段值转换为字符串，全文索引只支持字符串
			fieldStr := string(fieldValue)
			// 对字段值进行分词
			tokens := fullTextIndex.Tokenize(fieldStr)
			//tokens := GetFullTextToken(fieldStr, ftlen)
			for _, token := range tokens {
				if token == "" {
					continue
				}
				curpfx = append(curpfx, bytes.Join([][]byte{ftpxf, []byte(token)}, []byte(SPLIT)))
				//curpfx = append(curpfx, []byte(token))
			}
		case false: // 普通索引字段
			curpfx = append(curpfx, bytes.Join([][]byte{ftpxf, fieldValue}, []byte(SPLIT)))
			//curpfx = append(curpfx, fieldValue)
		}
		//返回结果是否为空
		isnil = r == nil
		switch isnil {
		case true:
			//r = append(r, append([][]byte{}, ftpxf...)...)
			r = append(r, append([][]byte{}, curpfx...)...)
		case false: // 拼接当前索引前缀到结果中,一对多和多对一关系，多对多已经过滤，属于非法。
			for i, idx := range r {
				for _, pfx := range curpfx {
					var tidx []byte
					tidx = append(tidx, append([]byte{}, idx...)...)
					var tpfx []byte
					tpfx = append(tpfx, append([]byte{}, pfx...)...)
					tidx = bytes.Join([][]byte{tidx, tpfx}, []byte{})
					r[i] = tidx
				}
			}
		}
		curpfx = curpfx[:0]
		ftpxf = ftpxf[:0]
	}
	return r
}

// ------------------------------------------
// 索引的结构体
type Index struct {
	set       []*FieldIndexKind // 主键字段列表，单主键长度为1，组合主键长度>1
	fieldKind FieldKind         //可以手动设置索引类型，如果没有手动设置，则根据set[0]的索引类型自动设置
	prefix    string            //索引前缀
	//AssertIndexKind        AssertIndexKind   //通过AssertIndexKind断言索引类型，返回IndexKind
	NormalIndexJoinValue   JoinIndexValue //普通索引值拼接函数
	FullTextIndexJoinValue JoinIndexValue //全文索引值拼接函数
}

func IndexNewDefault(fieldIndexKind []*FieldIndexKind) *Index {
	return &Index{
		set: fieldIndexKind,
		//AssertIndexKind:        DefaultAssertIndexKind,
		fieldKind:              nil,
		NormalIndexJoinValue:   DefaultJoinIndexValue,
		FullTextIndexJoinValue: DefaultJoinFullTextIndexValue,
	}
}

// 判断索引是何种类型,主键，普通索引，全文索引
// 默认为第一个索引字段默认，可以合适大部分业务场景，只有特殊场景才需要手动设置索引类型
func (idx *Index) GetFieldKind() FieldKind {
	if idx.fieldKind != nil {
		return idx.fieldKind
	}
	//idx.indexKind = idx.AssertIndexKind(fieldIndexKind)
	idx.fieldKind = idx.set[0].fieldKind
	return idx.fieldKind
}
func (idx *Index) Name() string {
	fields := make([]string, 0, len(idx.set))
	for _, fik := range idx.set {
		fields = append(fields, fik.Field())
	}
	return strings.Join(fields, "-")
}
func (idx *Index) Len() int {
	return len(idx.set)
}

// 设置索引前缀
func (idx *Index) SetPrefix(prefix string) {
	idx.prefix = prefix
}

// 获取索引前缀
// 默认使用第一个字段的索引类型名称作为索引前缀，基本上大部分业务场景都可以满足需求
// 如果业务场景有特殊需求，则可以手动设置索引前缀
func (idx *Index) Prefix() string {
	if idx.prefix == "" {
		if idx.fieldKind == nil {
			idx.prefix = idx.set[0].fieldKind.Name()
		} else {
			idx.prefix = idx.fieldKind.Name()
		}
	}
	return idx.prefix
}

// 默认普通索引值拼接，返回[]byte
func (idx *Index) IndexJoinValue(fieldsBytes *map[string][]byte, pkpfx ...string) any {
	return idx.NormalIndexJoinValue(fieldsBytes, idx.set, pkpfx...)
}

// 默认全文索引值拼接，返回[][]byte
func (idx *Index) FullTextJoinValue(fieldsBytes *map[string][]byte, pkpfx ...string) any {
	return idx.FullTextIndexJoinValue(fieldsBytes, idx.set, pkpfx...)
}

// ------------------------------------------

// 索引集的结构体
type Indexs struct {
	set []*Index // 主键字段列表，单主键长度为1，组合主键长度>1
	//primaryFields []*FieldIndexKind // 主键字段列表，单主键长度为1，组合主键长度>1
	primaryIndex *Index // 主键索引
}

// 主键必须先添加，才能优先匹配主键
func (is *Indexs) Add(index ...*Index) {
	is.set = append(is.set, index...)
}
func (is *Indexs) PrimaryIndex() *Index {
	if is.primaryIndex != nil {
		return is.primaryIndex
	}
	for _, idx := range is.set {
		kind := idx.GetFieldKind()
		// 检查索引类型是否为Primary
		if _, ok := kind.(*FieldPrimary); ok {
			is.primaryIndex = idx
			break // 找到主键索引后直接返回
		}
	}
	return is.primaryIndex
}
func (is *Indexs) PrimaryFields() []*FieldIndexKind {
	if is.primaryIndex != nil {
		return is.primaryIndex.set
	}
	is.PrimaryIndex()
	return is.primaryIndex.set
}

// 匹配索引
// 当用户提交查询时，根据查询的字段，匹配索引集中的对应索引
func (is *Indexs) Match(fields []string) *Index { //[]*FieldIndexKind {
	Count := 0
	//主键必须先添加，才能优先匹配主键，优先级由用户手动添加的顺序决定
	for _, idx := range is.set {
		for _, field := range idx.set {
			if slices.Contains(fields, field.field) {
				Count++
			}
		}
		if Count == len(idx.set) {
			return idx
		}
	}
	return nil
}

// 数据库的添加，删除，修改等操作
// 匹配字段ufield ，用于记录修改某个字段时，只需要处理这些字段的索引即可。
// ins 表示是否是插入操作，true 表示put操作，false 表示delete操作。
func (is *Indexs) Joins(fieldsBytes *map[string][]byte, pfx string, ufield ...string) (rs *IndexJoinValue) {
	rs = DefaultIndexJoinValuePool.Get()
	// 遍历索引集
	var indexValue any
	var indexValues any
	var fieldKind FieldKind

	for _, idx := range is.set {
		for _, fik := range idx.set {
			if len(ufield) > 0 { //更新模式
				if !slices.Contains(ufield, fik.Field()) { //非更新字段，跳过
					break
				}
			}
		}

		pkpfx := idx.Prefix()
		if pfx != "" {
			pkpfx = pfx + SPLIT + pkpfx
		}
		fieldKind = idx.GetFieldKind()
		switch fieldKind.(type) {
		case *FieldPrimary:
			indexValue = idx.IndexJoinValue(fieldsBytes)
			rs.PrimaryIDValue = indexValue.([]byte)
			// 添加索引前缀
			rs.PrimaryValue = bytes.Join([][]byte{[]byte(pkpfx), rs.PrimaryIDValue}, []byte(SPLIT))
			rs.PrimaryLen = len(idx.set)

		case *FieldFullTextIndex:
			indexValues = idx.FullTextJoinValue(fieldsBytes, pkpfx)
			fulltextvalue := indexValues.([][]byte)
			rs.OtherValues = append(rs.OtherValues, append([][]byte(nil), fulltextvalue...)...)
			continue

		case *FieldNormalIndex:
			indexValue = idx.IndexJoinValue(fieldsBytes, pkpfx)
			// 添加索引前缀
			rs.OtherValues = append(rs.OtherValues, append([]byte(nil), bytes.Join([][]byte{[]byte(nil), indexValue.([]byte)}, []byte(nil))...))
		case *FieldNoIndex:
			rs.OtherValues = append(rs.OtherValues, nil)
		default:
			continue
		}
	}
	fmt.Printf("rs.PrimaryLen: %v\n", rs.PrimaryLen)
	fmt.Printf("rs.PrimaryValue: %v\n", string(rs.PrimaryValue))
	fmt.Printf("rs.PrimaryIDValue: %v\n", string(rs.PrimaryIDValue))
	for _, v := range rs.OtherValues {
		fmt.Printf("v: %v\n", string(v))
	}
	return
}

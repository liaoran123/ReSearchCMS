package main

import (
	"fmt"
	"strconv"
)

// --- 函数类型定义 --- //
// ValueParseFun 定义值解析函数类型
// 用于将字节数组解析为特定类型

type ValueParseFun func(value []byte) any

// --- 接口定义 --- //
// ValueHandler 定义值处理器接口
// 包含值解析和值处理两个方法

type ValueHandler interface {
	// Parse 使用解析函数处理值
	Parse(value []byte) any
	// Process 处理解析后的值
	Process(parsedValue any) string
}

// --- 具体实现结构体 --- //
// DefaultValueHandler 是 ValueHandler 接口的默认实现
// 它使用函数类型作为字段，实现灵活的解析逻辑

type DefaultValueHandler struct {
	// parseFunc 是一个函数类型字段，用于存储具体的解析函数
	parseFunc ValueParseFun
}

// NewDefaultValueHandler 创建一个新的默认值处理器
func NewDefaultValueHandler(parseFunc ValueParseFun) *DefaultValueHandler {
	return &DefaultValueHandler{
		parseFunc: parseFunc,
	}
}

// Parse 实现 ValueHandler 接口的 Parse 方法
// 使用内部的 parseFunc 函数类型来解析值
func (h *DefaultValueHandler) Parse(value []byte) any {
	if h.parseFunc == nil {
		// 默认返回字符串
		return string(value)
	}
	return h.parseFunc(value)
}

// Process 实现 ValueHandler 接口的 Process 方法
// 处理解析后的值，返回字符串表示
func (h *DefaultValueHandler) Process(parsedValue any) string {
	switch v := parsedValue.(type) {
	case int:
		return fmt.Sprintf("Integer value: %d", v)
	case float64:
		return fmt.Sprintf("Float value: %.2f", v)
	case string:
		return fmt.Sprintf("String value: '%s'", v)
	default:
		return fmt.Sprintf("Unknown type: %v", v)
	}
}

// --- 预定义的解析函数 --- //

// IntParseFun 解析字节数组为整数
func IntParseFun(value []byte) any {
	intVal, _ := strconv.Atoi(string(value))
	return intVal
}

// FloatParseFun 解析字节数组为浮点数
func FloatParseFun(value []byte) any {
	floatVal, _ := strconv.ParseFloat(string(value), 64)
	return floatVal
}

// StringParseFun 解析字节数组为字符串
func StringParseFun(value []byte) any {
	return string(value)
}

// --- 另一个接口实现，展示多态 --- //

// CustomValueHandler 自定义值处理器
// 展示不同的接口实现

type CustomValueHandler struct {
	prefix string
}

func (h *CustomValueHandler) Parse(value []byte) any {
	// 自定义解析：添加前缀并转为字符串
	return h.prefix + string(value)
}

func (h *CustomValueHandler) Process(parsedValue any) string {
	// 自定义处理：全部转为大写
	if str, ok := parsedValue.(string); ok {
		return "CUSTOM: " + str
	}
	return "CUSTOM: invalid type"
}

// --- 使用示例 --- //

func main() {
	// 创建不同类型的值处理器
	handlers := []ValueHandler{
		// 使用 IntParseFun 函数类型创建处理器
		NewDefaultValueHandler(IntParseFun),
		// 使用 FloatParseFun 函数类型创建处理器
		NewDefaultValueHandler(FloatParseFun),
		// 使用 StringParseFun 函数类型创建处理器
		NewDefaultValueHandler(StringParseFun),
		// 使用匿名函数作为解析函数
		NewDefaultValueHandler(func(value []byte) any {
			return "ANONYMOUS: " + string(value)
		}),
		// 自定义处理器，不使用函数类型
		&CustomValueHandler{prefix: "PREFIX_"},
	}

	// 测试数据
	testValues := [][]byte{
		[]byte("123"),
		[]byte("45.67"),
		[]byte("hello"),
	}

	// 演示混合使用函数类型和接口
	fmt.Println("=== 混合使用函数类型和接口示例 ===")
	for i, handler := range handlers {
		fmt.Printf("\n--- 处理器 %d ---\n", i+1)
		for _, value := range testValues {
			parsed := handler.Parse(value)
			processed := handler.Process(parsed)
			fmt.Printf("输入: %s -> 解析: %v -> 处理: %s\n", value, parsed, processed)
		}
	}

	// 演示函数类型作为接口方法参数
	fmt.Println("\n=== 函数类型作为接口方法参数示例 ===")
	// 创建一个处理器，动态更换解析函数
	dynamicHandler := NewDefaultValueHandler(nil)
	
	// 使用整数解析
	dynamicHandler.parseFunc = IntParseFun
	result1 := dynamicHandler.Parse([]byte("789"))
	fmt.Printf("动态整数解析: %v -> %s\n", result1, dynamicHandler.Process(result1))
	
	// 切换到字符串解析
	dynamicHandler.parseFunc = StringParseFun
	result2 := dynamicHandler.Parse([]byte("789"))
	fmt.Printf("动态字符串解析: %v -> %s\n", result2, dynamicHandler.Process(result2))
}

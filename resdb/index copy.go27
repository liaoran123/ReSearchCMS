package resdb

import (
	"bytes"
	"errors"
	"slices"
)

// ------------------------------------------
// 基础索引接口，定义所有索引类型共有的方法
type Index interface {
	// 添加索引字段
	AddFields(field ...string)
	// 获取索引字段列表
	GetFields() []string
	// 获取索引前缀
	Prefix() string
	// 拼接索引前缀+索引值
	// 系统对kv数据库优化设计，将已经存在key值索引数据，从value中略去。使用时再重新分解拼接。
	// 所以，所有拼接数据都要进行转义。否则分解可能存在转义问题。
	Join(fieldsBytes *map[string][]byte, pfx string, existFields ...string) []byte
	// 匹配索引字段
	Match(fields ...string) bool
}

// ------------------------------------------
// 主键接口，嵌入基础索引接口
type PrimaryKey interface {
	Index
	// 获取主键ID
	ID() []byte
	// 拼接主键索引值
	//Join(fieldsBytes *map[string][]byte, pfx string) []byte
	// 获取主键字段数量
	Len() int
	// 设置主键ID
	SetID(fieldsBytes *map[string][]byte)
}

// ------------------------------------------
// 默认主键索引
type DefaultPrimaryKey struct {
	fields []string // 主键字段列表，数组，即是支持单主键，也支持组合主键
	id     []byte
	name   string
}

func DefaultPrimaryKeyNew() *DefaultPrimaryKey {
	return &DefaultPrimaryKey{
		name: "Primary",
	}
}
func (dpk *DefaultPrimaryKey) GetFields() []string {
	return dpk.fields
}
func (dpk *DefaultPrimaryKey) AddFields(field ...string) {
	dpk.fields = append(dpk.fields, field...)
}
func (dpk *DefaultPrimaryKey) Prefix() string {
	return dpk.name
}
func Match(fields []string, existFields ...string) bool {
	count := 0
	for _, fit := range fields {
		//判断是否存在切片中
		if slices.Contains(fields, fit) {
			count++
		}
	}
	return count == len(existFields) //兼容匹配，主键字段可以少于索引字段
}
func (dpk *DefaultPrimaryKey) Match(fields ...string) bool {
	return Match(fields, dpk.fields...)
}
func (dpk *DefaultPrimaryKey) Len() int {
	return len(dpk.fields)
}

// 存在某个字段
func exist(fields []string, existFields ...string) bool {
	if len(existFields) == 0 {
		return true
	}
	for _, fit := range existFields {
		//判断是否存在切片中
		if slices.Contains(fields, fit) {
			return true
		}
	}
	return false
}
func (dpk *DefaultPrimaryKey) Join(fieldsBytes *map[string][]byte, pfx string, existFields ...string) []byte {
	if !exist(dpk.fields, existFields...) {
		return nil
	}
	var Value bytes.Buffer
	if pfx != "" {
		Value.Write(Bytes([]byte(pfx)).Escape())
		Value.Write([]byte(SPLIT))
	}
	dpkPfx := []byte(dpk.Prefix())
	Value.Write(Bytes(dpkPfx).Escape())
	Value.Write([]byte(SPLIT))
	if dpk.id == nil {
		dpk.SetID(fieldsBytes)
	}
	Value.Write(dpk.id)
	return Value.Bytes()
}

func (dpk *DefaultPrimaryKey) SetID(fieldsBytes *map[string][]byte) {
	if dpk.id == nil {
		dpk.id = Join(fieldsBytes, dpk.fields)
	}
}

func (dpk *DefaultPrimaryKey) ID() []byte {
	return dpk.id
}

// ------------------------------------------
// 普通索引接口，嵌入基础索引接口
type NormalIndex interface {
	Index
	// 拼接普通索引值
	//Join(fieldsBytes *map[string][]byte, pfx string) []byte
}

// ------------------------------------------
// 默认普通索引
type DefaultNormalIndex struct {
	fields []string
	name   string
}

func DefaultNormalIndexNew() *DefaultNormalIndex {
	return &DefaultNormalIndex{
		name: "Normal",
	}
}
func (dni *DefaultNormalIndex) Prefix() string {
	return dni.name
}
func (dni *DefaultNormalIndex) GetFields() []string {
	return dni.fields
}
func (dni *DefaultNormalIndex) AddFields(field ...string) {
	dni.fields = append(dni.fields, field...)
}

// 系统对kv数据库优化设计，将已经存在key值索引数据，从value中略去。使用时再重新分解拼接。
// 所有拼接数据都要进行转义
// 添加匹配字段功能
func Join(fieldsBytes *map[string][]byte, fields []string, existFields ...string) []byte {
	if !exist(fields, existFields...) {
		return nil
	}
	var Value bytes.Buffer
	for i, fit := range fields {
		if !slices.Contains(existFields, fit) {
			continue
		}
		if v, ok := (*fieldsBytes)[fit]; ok {
			v = Bytes(v).Escape()
			Value.Write(v)
			if i < len(fields)-1 {
				Value.Write([]byte(SPLIT))
			}
		}
	}
	return Value.Bytes()
}
func (dni *DefaultNormalIndex) Join(fieldsBytes *map[string][]byte, pfx string, existFields ...string) []byte {
	if !exist(dni.fields, existFields...) {
		return nil
	}
	var Value bytes.Buffer
	if pfx != "" {
		Value.Write(Bytes([]byte(pfx)).Escape())
		Value.Write([]byte(SPLIT))
	}
	dniPfx := []byte(dni.Prefix())
	Value.Write(Bytes(dniPfx).Escape())
	Value.Write([]byte(SPLIT))
	Value.Write(Join(fieldsBytes, dni.fields))
	return Value.Bytes()
}

func (dni *DefaultNormalIndex) Match(fields ...string) bool {
	return Match(fields, dni.fields...)
}

// ------------------------------------------
// 全文索引接口，嵌入基础索引接口
type FullTextIndex interface {
	Index
	// 拼接全文索引值
	Joins(fieldsBytes *map[string][]byte, pfx string, existFields ...string) [][]byte
	// 分词方法
	Tokenize(nr string, ftlen int) (tokens []string)
}

// ------------------------------------------
// 全文索引字段类型
type FullTextIndexField struct {
	Fields string // 全文索引字段名
	Len    int    // 全文索引字段长度
}

// ------------------------------------------
// 默认全文索引
type DefaultFullTextIndex struct {
	fields   []string
	ftfields []FullTextIndexField
	name     string
}

func DefaultFullTextIndexNew() *DefaultFullTextIndex {
	return &DefaultFullTextIndex{
		name: "FullText",
	}
}
func (dfi *DefaultFullTextIndex) GetFields() []string {
	return dfi.fields
}
func (dfi *DefaultFullTextIndex) Prefix() string {
	return dfi.name
}
func (dfi *DefaultFullTextIndex) AddFields(field ...string) {
	dfi.fields = append(dfi.fields, field...)
}

// 指定那个字段是全文索引字段，以及索引长度
func (dfi *DefaultFullTextIndex) AddFullText(field string, len int) error {
	//len限制为3-11个字符
	if len < 3 || len > 11 {
		return errors.New("FullText index len must be between 3 and 11")
	}
	dfi.ftfields = append(dfi.ftfields, FullTextIndexField{
		Fields: field,
		Len:    len,
	})
	return nil
}
func (dfi *DefaultFullTextIndex) Tokenize(nr string, ftlen int) (tokens []string) {
	var knr string //, fid
	var ml, cl int
	var r, idxstr []rune
	r = []rune(nr)
	cl = len([]rune(nr))
	for cl > 0 {
		ml = min(cl, ftlen)
		idxstr = r[:ml]
		knr = string(idxstr)
		tokens = append(tokens, knr)
		r = r[1:]
		cl = len(r)
	}
	return
}

// 普通拼接，用于索引时的前缀拼接
func (dfi *DefaultFullTextIndex) Join(fieldsBytes *map[string][]byte, pfx string, existFields ...string) []byte {
	if !exist(dfi.fields, existFields...) {
		return nil
	}
	dfiPfx := dfi.Prefix()
	if len(pfx) > 0 {
		dfiPfx = pfx + SPLIT + dfiPfx // + SPLIT
	}
	var Value bytes.Buffer
	if pfx != "" {
		Value.Write(Bytes([]byte(pfx)).Escape())
		Value.Write([]byte(SPLIT))
	}
	Value.Write(Bytes([]byte(dfiPfx)).Escape())
	Value.Write([]byte(SPLIT))
	Value.Write(Join(fieldsBytes, dfi.fields))
	return Value.Bytes()
}

// 拼接全文索引值，最后都会将主键值拼接在最后,kv: 键值对里，value是nil.。
// 解析时需要全文索引值中分解出主键值，所以所有的拼接值都需要转义。
// 搜索词也需要转义，否则无法匹配。
func (dfi *DefaultFullTextIndex) Joins(fieldsBytes *map[string][]byte, pfx string, existFields ...string) [][]byte {
	if !exist(dfi.fields, existFields...) {
		return nil
	}
	var r [][]byte
	var fieldValue []byte
	var exists bool
	var curpfx [][]byte
	//curpfx = append(curpfx, fullTextPrefix)
	ftpxf := []byte(pfx)
	ftpxf = Bytes(ftpxf).Escape()
	dfipxf := []byte(dfi.Prefix())
	dfipxf = Bytes(dfipxf).Escape()
	if len(ftpxf) > 0 {
		ftpxf = bytes.Join([][]byte{ftpxf, dfipxf}, []byte(SPLIT))
	} else {
		ftpxf = dfipxf
	}

	var isnil bool
	for _, fit := range dfi.fields {
		// 获取字段的实际值
		fieldValue, exists = (*fieldsBytes)[fit]
		if !exists {
			continue // 跳过不存在的字段
		}
		var isFullTextField bool
		var ftlen int

		//组合全文索引时，全文索引字段和普通索引字段组合，需要判断那个字段是全文索引字段
		for _, ftfit := range dfi.ftfields {
			if fit == ftfit.Fields {
				isFullTextField = true
				ftlen = ftfit.Len
				break
			}
		}
		switch isFullTextField {
		case true: // 全文索引字段
			// 将字段值转换为字符串，全文索引只支持字符串
			fieldStr := string(fieldValue)
			// 对字段值进行分词
			tokens := dfi.Tokenize(fieldStr, ftlen)
			var btoken []byte
			for _, token := range tokens {
				if token == "" {
					continue
				}
				btoken = []byte(token)
				btoken = Bytes(btoken).Escape()
				curpfx = append(curpfx, bytes.Join([][]byte{ftpxf, btoken}, []byte(SPLIT)))
				//curpfx = append(curpfx, []byte(token))
			}
		case false: // 普通索引字段
			fieldValue = Bytes(fieldValue).Escape()
			curpfx = append(curpfx, bytes.Join([][]byte{ftpxf, fieldValue}, []byte(SPLIT)))
			//curpfx = append(curpfx, fieldValue)
		}
		//返回结果是否为空
		isnil = r == nil
		switch isnil {
		case true:
			//r = append(r, append([][]byte{}, ftpxf...)...)
			r = append(r, append([][]byte{}, curpfx...)...)
		case false: // 拼接当前索引前缀到结果中,一对多和多对一关系，多对多等。多对多可能并无意义，但是系统只是支持。
			for i, idx := range r {
				for _, pfx := range curpfx {
					var tidx []byte
					tidx = append(tidx, append([]byte{}, idx...)...)
					var tpfx []byte
					tpfx = append(tpfx, append([]byte{}, pfx...)...)
					tidx = bytes.Join([][]byte{tidx, tpfx}, []byte{})
					r[i] = tidx
				}
			}
		}
		curpfx = curpfx[:0]
		ftpxf = ftpxf[:0]
	}
	return r
}
func (dfi *DefaultFullTextIndex) Match(fields ...string) bool {
	return Match(fields, dfi.fields...)
}

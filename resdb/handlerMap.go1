package resdb

import "sync"

/*
func init() {
	DbHandler = NewDBHandler()
	DbHandler.AddHandler("parserRecordByIndex", func(table *Table, value []byte, fieldHandler ...FieldHandler) any {
		return parserRecordByIndex(table, value)
	})
	DbHandler.AddHandler("parserRecordByPrimary", func(table *Table, value []byte, fieldHandler ...FieldHandler) any {
		return parserRecordByPrimary(table, value, fieldHandler...)
	})
}
*/
var DbHandler *dbHandler

// 定义数据库操作接口，分别处理主键和索引相关功能
type dbHandler struct {
	/*
		map[string]Handler string即key的命名规则示例：
		SelectByPrimary
		SelectByIndex
		Select：功能，比如查询。由用户自定义。
		ByPrimary：根据主键的查询功能。
		ByIndex：根据索引的查询功能。
		这两个是固定的，系统会根据查询使用的主键或索引来调用对应的Handler。
		如果没有需要区分主键和索引的功能，则直接命名为Select即可。
	*/
	handlerMap map[string]Handler
	mu         sync.RWMutex
}

func NewDBHandler() *dbHandler {
	return &dbHandler{
		handlerMap: make(map[string]Handler),
	}
}

//添加Handler
/*
	如果返回值不是any，通过转换为any类型。
	如：
	db := NewDBHandler()
	db.AddHandler("SelectByPrimary", func(table *Table, value []byte) any {
		return ParserRecordByPrimary(table, value)
	})

*/

func (h *dbHandler) AddHandler(name string, handler Handler) {
	h.mu.Lock()
	defer h.mu.Unlock()
	h.handlerMap[name] = handler
}
func (h *dbHandler) GetHandler(name string) Handler {
	h.mu.RLock()
	defer h.mu.RUnlock()
	return h.handlerMap[name]
}

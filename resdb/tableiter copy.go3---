package resdb

import (
	"sync"

	"github.com/syndtr/goleveldb/leveldb/iterator"
)

// 基础迭代器结构体，提取公共字段和方法
type baseIter struct {
	table      *Table
	showfields []string
	indexs     *Indexs //搜索时使用的索引
	move       map[bool]func() bool
	top        map[bool]func() bool
	mu         sync.Mutex
}

// 实现sql语句中的select f0,f1,... from table 要返回的字段
// 如果keys为空，则返回所有字段
// 在最底层转换，最大化减少内存占用
type TableIter struct {
	baseIter
	iter iterator.Iterator
}

// 解析函数
type Parser func(k, v []byte) Record

// 导出函数
type Export func(k, v []byte) bool

func TableIterNew(table *Table, iter iterator.Iterator, indexs *Indexs, showfields ...string) *TableIter {
	return &TableIter{
		baseIter: baseIter{
			table:      table,
			showfields: showfields,
			indexs:     indexs,
			move: map[bool]func() bool{
				true:  iter.Next,
				false: iter.Prev,
			},
			top: map[bool]func() bool{
				true:  iter.First,
				false: iter.Last,
			},
		},
		iter: iter,
	}
}
func (t *TableIter) Release() {
	t.iter.Release()
}

// 遍历迭代器返回解析后的记录
func (t *TableIter) For(parser Parser, esc bool, limit ...int) (r Records) {
	//添加锁，防止并发访问
	t.mu.Lock()
	defer t.mu.Unlock()

	if !t.top[esc]() {
		return nil
	}
	var rd Record
	var start int
	var count int
	switch len(limit) {

	case 0:
		start = 0
		count = -1
	case 1:
		count = limit[0]
	default:
		start = limit[0]
		count = limit[1]
	}
	if count > 0 {
		r = make(Records, 0, count)
	}
	loop := 0
	// 处理当前位置的元素
	for {
		if loop < start {
			loop++
		} else {
			rd = parser(t.iter.Key(), t.iter.Value())
			r = append(r, rd)
			if count > 0 && len(r) >= count {
				break
			}
		}
		// 移动到下一个/前一个元素
		if !t.move[esc]() {
			break
		}
	}
	return r
}

// 解析主键记录
func (t *TableIter) parserRecordByPrimary(k, v []byte) Record {
	return Record(t.table.ParseValue(v)).GetKeys(t.showfields...)
}

// 获取所有主键记录
func (t *TableIter) GetRecordsByPrimary(esc bool) (r Records) {
	return t.For(t.parserRecordByPrimary, esc)
}

// 反转义
// 组合主键时，所有索引对应的主键值都是经过转义的。
// 这是为了提取主键中的某个字段值作为匹配索引。
// 所以在用索引的主键值回表记录时，需要对索引值进行反转义。
// 是否是组合主键
func (t *TableIter) UnEscape(v []byte) []byte {
	isComposite := len(t.table.primary) > 1
	if isComposite {
		return Bytes(v).UnEscape()
	}
	return v
}

// 将主键转为字符串 ，主要是用于组合主键需要进行map比较时使用
func (t *TableIter) PrimaryToStr(k []byte) string {
	/*
		isComposite := len(t.table.primary) > 1
		if !isComposite {
			return ""
		}*/
	var key any
	rstr := ""
	for _, p := range t.table.primary {
		key = Bytes(k).ToAny(t.table.fields[p])
		rstr += string(AnyToBytes(key)) + SPLIT
	}
	return rstr[:len(rstr)-1]
}

// 解析索引记录
func (t *TableIter) parserRecordByIndex(k, v []byte) Record {
	// 读取完整记录
	byrecord := t.table.ReadByBytes(t.UnEscape(v))
	if byrecord == nil {
		return nil
	}
	// 解析记录并提取指定字段
	return Record(t.table.ParseValue(byrecord)).GetKeys(t.showfields...)
}

// 获取所有索引记录
func (t *TableIter) GetRecordsByIndex(esc bool) (r Records) {
	return t.For(t.parserRecordByIndex, esc)
}

// 判断是否存在指定的主键记录
func (t *TableIter) Exist() bool {
	return t.iter.First()
}

// 统计索引记录数
func (t *TableIter) Count() int {
	t.mu.Lock()
	defer t.mu.Unlock()
	i := 0
	for t.iter.Next() {
		i++
	}
	return i
}

// 遍历迭代器进行匹配
func (t *TableIter) ForMatch(parser Parser, esc bool, start, count int, match ...MatchRule) (r Records) {
	//添加锁，防止并发访问
	t.mu.Lock()
	defer t.mu.Unlock()

	if !t.top[esc]() {
		return nil
	}
	var rd Record
	var md any
	if count > 0 {
		r = make(Records, 0, count)
	}
	loop := 0
	var res bool
	// 处理当前位置的元素
	for {
		if loop < start {
			loop++
		} else {
			res = true
			for _, m := range match {
				//需要匹配字段变量
				needmatch := len(m.Fields) == 0
				switch needmatch {
				case false:
					//默认是主键值，组合主键则返回字符串
					//是否组合主键
					isComposite := len(t.table.primary) > 1
					if isComposite {
						md = t.PrimaryToStr(t.iter.Value())
					} else {
						md = Bytes(t.iter.Value()).ToAny(t.table.fields[t.table.primary[0]])
					}
				default:
					//根据m.Fields获取rd的对应字段值
					md = rd.GetKeys(m.Fields...)
				}
				if m.Match(md) != m.Rule {
					res = false
					break
				}
			}
			if res {
				rd = parser(t.iter.Key(), t.iter.Value())
				r = append(r, rd)
				if count > 0 && len(r) >= count {
					break
				}
			}
		}
		// 移动到下一个/前一个元素
		if !t.move[esc]() {
			break
		}
	}
	return r
}

// 遍历迭代器导出数据
func (t *TableIter) ForExport(esc bool, export Export) {
	t.mu.Lock()
	defer t.mu.Unlock()
	if !t.top[esc]() {
		return
	}
	for {
		if !export(t.iter.Key(), t.iter.Value()) {
			return
		}
		if !t.move[esc]() {
			return
		}
	}
}

// 提取转换主键值
// 单主键则返回转换的值，组合主键则返回字符串
// field用于对组合主键提取其中的部分值
func (t *TableIter) GetPrimaryKeys(field ...string) (r any) {
	//是否组合主键
	isComposite := len(t.table.primary) > 0
	switch isComposite {
	case true:
		// 组合主键，返回字符串
		keys := Bytes(t.iter.Key()).Split()
		if len(field) > 0 {
			newkeys := ""
			for _, f := range field {
				for i, p := range t.table.primary {
					if f == p {
						newkeys += string(keys[i]) + SPLIT
					}
				}
			}
			r = newkeys[:len(newkeys)-1]
		}
	default:
		// 单主键，返回转换的值
		r = Bytes(t.iter.Value()).ToAny(t.table.fields[t.table.primary[0]])
	}
	return r
}

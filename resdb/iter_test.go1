// TestIterConvertRecord 测试ConvertRecord方法
func TestIterConvertRecord(t *testing.T) {
	table, err := TableNew("test_table")
	if err != nil {
		t.Fatalf("TableNew 失败: %v", err)
	}

	// 设置主键字段和类型
	table.primary = "id"
	table.fields["id"] = "int64" // 假设主键是id，类型是int64

	iter := IterNew(nil, table)
	if iter == nil {
		// 创建IterNew返回nil，我们手动创建一个Iter实例进行测试
		iter = &Iter{
			table: table,
		}
	}

	// 注意：ConvertRecord方法依赖于Table.ParseValue和Table.Read方法
	// 这些方法需要实际的数据库实现，所以我们不能完全测试它们的功能
	// 我们只测试基本的错误处理

	// 测试nil输入
	record, _ := iter.ConvertRecord(false, nil, nil)
	if record != nil {
		t.Error("ConvertRecord 应该返回 nil 当传入 nil 输入时")
	}

	// 测试空输入
	record, _ = iter.ConvertRecord(false, []byte(""), []byte(""))
	// 这里record可能为nil，因为解析空值可能失败
	// 我们不做断言，只确保方法不会崩溃

	// 测试索引数据转换
	record, _ = iter.ConvertRecord(true, nil, []byte(""))
	// 这里record可能为nil，因为table.Read方法需要实际的数据库实现
	// 我们不做断言，只确保方法不会崩溃
}

// TestIterIntersectUnionExcept 测试Intersect、Union、Except方法
func TestIterIntersectUnionExcept(t *testing.T) {
	table, err := TableNew("test_table")
	if err != nil {
		t.Fatalf("TableNew 失败: %v", err)
	}

	// 设置主键字段类型
	table.fields["id"] = int64(0) // 假设主键是id，类型是int64

	iter := IterNew(nil, table)
	if iter != nil {
		// 测试Intersect方法
		result := iter.Intersect(false, 0, 10)
		if result != nil {
			t.Error("Intersect 应该返回 nil 当迭代器为 nil 时")
		}

		// 测试Union方法
		result = iter.Union(false, 0, 10)
		if result != nil {
			t.Error("Union 应该返回 nil 当迭代器为 nil 时")
		}

		// 测试Except方法
		result = iter.Except(false, 0, 10)
		if result != nil {
			t.Error("Except 应该返回 nil 当迭代器为 nil 时")
		}
	}

	// 注意：完整的Intersect、Union、Except测试需要一个实际的leveldb迭代器实例
}


// 测试文件，对应 Iter.go
package resdb

import (
	"testing"
)

// TestIterNew 测试IterNew函数
func TestIterNew(t *testing.T) {
	// 测试创建正常迭代器
	table, err := TableNew("test_table")
	if err != nil {
		t.Fatalf("TableNew 失败: %v", err)
	}

	// 这里我们需要一个实际的iterator.Iterator实例，但由于我们没有实际的leveldb迭代器
	// 我们先测试nil情况
	iter := IterNew(nil, table)
	if iter != nil {
		t.Error("IterNew 应该返回 nil 当传入 nil 迭代器时")
	}

	// 注意：完整的IterNew测试需要一个实际的leveldb迭代器实例
	// 这里我们只测试了nil情况，实际使用时需要更多测试
}

// TestIterFirstLastNextPrev 测试First、Last、Next、Prev方法
func TestIterFirstLastNextPrev(t *testing.T) {
	table, err := TableNew("test_table")
	if err != nil {
		t.Fatalf("TableNew 失败: %v", err)
	}

	iter := IterNew(nil, table)
	if iter != nil {
		// 测试First方法
		key, value := iter.First()
		if key != nil || value != nil {
			t.Error("First 应该返回 nil, nil 当迭代器为 nil 时")
		}

		// 测试Last方法
		key, value = iter.Last()
		if key != nil || value != nil {
			t.Error("Last 应该返回 nil, nil 当迭代器为 nil 时")
		}

		// 测试Next方法
		key, value = iter.Next()
		if key != nil || value != nil {
			t.Error("Next 应该返回 nil, nil 当迭代器为 nil 时")
		}

		// 测试Prev方法
		key, value = iter.Prev()
		if key != nil || value != nil {
			t.Error("Prev 应该返回 nil, nil 当迭代器为 nil 时")
		}
	}

	// 注意：完整的方法测试需要一个实际的leveldb迭代器实例
}

// TestIterForFn 测试ForFn方法
func TestIterForFn(t *testing.T) {
	table, err := TableNew("test_table")
	if err != nil {
		t.Fatalf("TableNew 失败: %v", err)
	}

	iter := IterNew(nil, table)
	if iter != nil {
		// 测试ForFn方法
		called := false
		iter.ForFn(func(k, v []byte) {
			called = true
		}, true)
		if called {
			t.Error("ForFn 不应该调用回调函数当迭代器为 nil 时")
		}
	}

	// 注意：完整的ForFn测试需要一个实际的leveldb迭代器实例
}


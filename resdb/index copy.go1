package resdb

import (
	"bytes"
	"slices"
)

// 定义索引类型接口
type Kind interface {
	Name() string
	JoinIndexValue(fieldsBytes *map[string][]byte, fields []string) any
}

// 主键索引
type Primary struct{}

func (p *Primary) Name() string {
	return "Primary"
}
func (p *Primary) JoinIndexValue(fieldsBytes *map[string][]byte, fields []string) any {
	return DefaultJoinIndexValue(fieldsBytes, fields)
}

// 普通索引
type Normal struct{}

func (i *Normal) Name() string {
	return "Normal"
}
func (i *Normal) JoinIndexValue(fieldsBytes *map[string][]byte, fields []string) any {
	return DefaultJoinIndexValue(fieldsBytes, fields)
}

// 全文索引
type FullText struct{}

func (i *FullText) Name() string {
	return "FullText"
}
func (i *FullText) JoinIndexValue(fieldsBytes *map[string][]byte, fields []string) any {
	return nil
}

// ------------------------------------------
// 组织索引值
// 组合索引值，主键和索引是一样的，但是全文索引不同。
type JoinIndexValue func(fieldsBytes *map[string][]byte, fields []string) any

// 将字段对应的字节值拼接起来，用SPLIT分隔
func DefaultJoinIndexValue(fieldsBytes *map[string][]byte, fields []string) any {
	var indexValue []byte
	for i, field := range fields {
		if v, ok := (*fieldsBytes)[field]; !ok {
			return nil
		} else {
			indexValue = append(indexValue, v...)
			if i < len(fields)-1 {
				indexValue = append(indexValue, SPLIT...)
			}
		}
	}
	return indexValue
}

// ------------------------------------------
// 字段索引类型
type FieldIndex struct {
	field string
	kind  Kind
}

func (fi *FieldIndex) Set(field string, kind Kind) {
	fi.field = field
	fi.kind = kind
}

// 字段索引类型
type FieldIndexKind struct {
	field string
	kind  IndexKind
}

// 设置值
func (fit *FieldIndexKind) Set(field string, kind IndexKind) {
	fit.field = field
	fit.kind = kind
}

// 获取索引类型
func (fit *FieldIndexKind) Kind() IndexKind {
	return fit.kind
}

// 获取索引字段
func (fit *FieldIndexKind) Field() string {
	return fit.field
}

// ------------------------------------------
// 断言索引类型函数
type AsserIndexKind = func(indexType *[]FieldIndexKind) IndexKind

// 默认断言索引类型函数
func DefaultAsserIndexKind(indexType *[]FieldIndexKind) IndexKind {
	PrimaryKeyIndexCount := 0
	NormalIndexCount := 0
	FullTextIndexCount := 0
	for _, fit := range *indexType {
		switch fit.Kind() {
		case PrimaryKeyIndex:
			PrimaryKeyIndexCount++
		case NormalIndex:
			NormalIndexCount++
		case FullTextIndex:
			FullTextIndexCount++
		}
	}
	//优先1
	//规则是：有一个主键，则认为是主键索引
	if PrimaryKeyIndexCount > 0 {
		return PrimaryKeyIndex
	}
	//优先2
	//规则是：有一个全文索引，则认为是全文索引
	if FullTextIndexCount > 0 {
		return FullTextIndex
	}
	//优先3
	//规则是：剩下的是普通索引
	if NormalIndexCount > 0 {
		return NormalIndex
	}
	return (*indexType)[0].Kind()
}

// ------------------------------------------
// 索引的结构体
type Index struct {
	set            []FieldIndexKind // 主键字段列表，单主键长度为1，组合主键长度>1
	asserIndexKind AsserIndexKind
	joinIndexValue JoinIndexValue
}

func IndexNew(indexType []FieldIndexKind, assertIndexKind AsserIndexKind, joinIndexValue JoinIndexValue) *Index {
	return &Index{
		set:            indexType,
		asserIndexKind: assertIndexKind,
		joinIndexValue: joinIndexValue,
	}
}
func IndexNewDefault(indexType []FieldIndexKind) *Index {
	return IndexNew(indexType, DefaultAsserIndexKind, DefaultJoinIndexValue)
}
func (idx *Index) AsserIndexKind(indexType *[]FieldIndexKind) IndexKind {
	return idx.asserIndexKind(indexType)
}
func (idx *Index) JoinIndexValue(fieldsBytes *map[string][]byte, fields []string) any {
	return idx.joinIndexValue(fieldsBytes, fields)
}

// ------------------------------------------
// 定义各个索引的前缀
type Prefix func(tbname string, indexKind IndexKind) string

func DefaultPrefix(tbname string, indexKind IndexKind) string {
	return tbname + SPLIT + "indexKind.String()" + SPLIT
}

// ------------------------------------------
// 索引集的结构体
type IndexSet struct {
	set []Index // 主键字段列表，单主键长度为1，组合主键长度>1
}

// 添加索引,主键必须先添加，才能优先匹配主键
func (is *IndexSet) Add(index ...Index) {
	is.set = append(is.set, index...)
}

// 获取前缀
func (is *IndexSet) GetPrefix(prefix Prefix, tbname string, indexKind IndexKind) string {
	return prefix(tbname, indexKind)
}

// 匹配索引
func (is *IndexSet) Match(fields []string) []FieldIndexKind {
	Count := 0
	//主键必须先添加，才能优先匹配主键
	for _, idx := range is.set {
		for _, field := range idx.set {
			if slices.Contains(fields, field.field) {
				Count++
			}
		}
		if Count == len(idx.set) {
			return idx.set
		}
	}
	return nil
}

// 获取索引值
func (is *IndexSet) GetIndexValue(fieldsBytes *map[string][]byte, fields []string) any {
	/*
		for _, idx := range is.set {
			matched := is.Match(fields)
			if matched == nil {
				continue
			}
			if idx.AsserIndexKind(&matched) == idx.Kind() {
				return idx.JoinIndexValue(fieldsBytes, fields)
			}
		}*/
	return nil
}

// 判断规则变量
type Assert = func(indexType *[]FieldIndexKind) IndexKind

// 默认索引规则
func DefaultAssert(indexType *[]FieldIndexKind) IndexKind {
	PrimaryKeyIndexCount := 0
	NormalIndexCount := 0
	FullTextIndexCount := 0
	for _, fit := range *indexType {
		switch fit.Kind() {
		case PrimaryKeyIndex:
			PrimaryKeyIndexCount++
		case NormalIndex:
			NormalIndexCount++
		case FullTextIndex:
			FullTextIndexCount++
		}
	}
	//优先1
	//规则是：有一个主键，则认为是主键索引
	if PrimaryKeyIndexCount > 0 {
		return PrimaryKeyIndex
	}
	//优先2
	//规则是：有一个全文索引，则认为是全文索引
	if FullTextIndexCount > 0 {
		return FullTextIndex
	}
	//优先3
	//规则是：剩下的是普通索引
	if NormalIndexCount > 0 {
		return NormalIndex
	}

	return NoIndex
}

// 通过GetPrefix函数的参数：先从Match匹配返回的索引indexType和GetIndexValue获取索引值value拼接索引前缀
// 这个函数用于自定义索引前缀和索引规则
func (is *IndexSet) GetPrefixValue(prefix Prefix, assert Assert, tbname string, indexType *[]FieldIndexKind, value []byte) []byte {
	pfx := is.GetPrefix(prefix, tbname, assert(indexType))
	r := bytes.Join([][]byte{[]byte(pfx), value}, []byte(SPLIT))
	return r
}

// 通过GetPrefix函数的参数：先从Match匹配返回的索引indexType和GetIndexValue获取索引值value拼接索引前缀(使用默认DefaultPrefix,DefaultIndexRule)
func (is *IndexSet) GetDefaultPrefixValue(tbname string, indexType *[]FieldIndexKind, value []byte) []byte {
	pfx := is.GetPrefix(DefaultPrefix, tbname, DefaultAssert(indexType))
	r := bytes.Join([][]byte{[]byte(pfx), value}, []byte(SPLIT))
	return r
}

// 通过fieldsBytes *map[string][]byte, fields []string获取Prefix
func (is *IndexSet) GetIndexPrefix(tbname string, fields []string, fieldsBytes *map[string][]byte) []byte {
	indexType := is.Match(fields)
	if indexType == nil {
		return nil
	}
	indexValue := is.GetIndexValue(fieldsBytes, fields)
	if indexValue == nil {
		return nil
	}
	return is.GetDefaultPrefixValue(tbname, &indexType, indexValue.([]byte))
}

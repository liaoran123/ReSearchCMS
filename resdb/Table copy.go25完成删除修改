// 从按主键数据库读取记录
func (t *Table) ReadByBytes(key []byte) []byte {
	key = nil // bytes.Join([][]byte{[]byte(t.GetPrimaryPrefix()), key}, []byte(SPLIT))
	v, err := t.rsdb.Db.Get(key, nil)
	if err != nil {
		// leveldb.ErrNotFound 是正常的未找到错误，不需要打印
		if err != leveldb.ErrNotFound {
			fmt.Printf("读取记录失败: %v\n", err)
		}
		return nil
	}
	return v
}

// 遍历表所有kv，复制表用
func (t *Table) For() iterator.Iterator {
	pfx := t.name + SPLIT
	return t.rsdb.GetIterator([]byte(pfx))
}

// 遍历表所有数据
func (t *Table) ForData() iterator.Iterator {
	pfx := t.name + SPLIT + t.primaryKey.Prefix()
	return t.rsdb.GetIterator([]byte(pfx))
}

// 匹配对应的索引字段和索引类型
// 需要完全匹配，不能部分匹配

// 检测索引索引，并且返回类型枚举
func (t *Table) MatchIndex(fields ...string) Index {
	if t.primaryKey.MatchFields(fields...) {
		return t.primaryKey
	}
	for _, ftidx := range t.fullTextIndex {
		if ftidx.MatchFields(fields...) {
			return ftidx
		}
	}
	for _, nidx := range t.normalIndex {
		if nidx.MatchFields(fields...) {
			return nidx
		}
	}
	return nil
}

// 根据字段名和值搜索返回数据迭代器
// 缓存迭代器，避免每次for都重新创建迭代器
func (t *Table) Search(fields *map[string]any) (iterator.Iterator, Index, error) {
	var field []string
	for k := range *fields {
		//判断字段是否在表中
		if _, ok := t.fields[k]; !ok {
			return nil, nil, fmt.Errorf("字段 '%s' 不存在于表 '%s'", k, t.name)
		}
		field = append(field, k)
	}
	idx := t.MatchIndex(field...)
	if idx == nil {
		return nil, nil, fmt.Errorf("字段 '%s' 不存在于表 '%s'", field[0], t.name)
	}
	fieldsBytes := t.FieldsToBytes(fields)
	key := idx.JoinValue(&fieldsBytes, t.name)
	return t.rsdb.GetIterator(key), idx, nil
}

func (t *Table) SearchToDataIter(fields *map[string]any) *TableIter {
	iter, index, err := t.Search(fields)
	if err != nil {
		fmt.Printf("搜索失败: %v\n", err)
		return nil
	}
	return TableIterNew(t, iter, index)
}

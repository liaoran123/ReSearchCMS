func (t *Table) GetName() string {
	return t.name
}

// GetPrimary 获取主键字段名
func (t *Table) GetPrimary() []string {
	primaryFields := make([]string, len(t.primaryKey.GetFields()))
	for _, field := range t.primaryKey.GetFields() {
		primaryFields = append(primaryFields, field)
	}
	return primaryFields
}


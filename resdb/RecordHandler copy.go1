		return ParserRecordByPrimary(table, value)
	})


func (h *recordHandler) AddHandler(name string, handler RecordHandler) {
	h.mu.Lock()
	defer h.mu.Unlock()
	h.handlerMap[name] = handler
}
func (h *recordHandler) GetHandler(name string) RecordHandler {
	h.mu.RLock()
	defer h.mu.RUnlock()
	return h.handlerMap[name]
}

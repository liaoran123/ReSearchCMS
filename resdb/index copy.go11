package resdb

import (
	"bytes"
	"fmt"
	"slices"
	"strings"
)

// ------------------------------------------

// 定义索引类型接口
type IndexKind interface {
	Name() string
}

// 没有索引
type NoIndex struct{}

func (n *NoIndex) Name() string {
	return "NoIndex"
}

// 主键索引
type Primary struct{}

func (p *Primary) Name() string {
	return "Primary"
}

// 普通索引
type NormalIndex struct{}

func (i *NormalIndex) Name() string {
	return "Normal"
}

// 全文索引
type FullTextIndex struct {
	ftlen uint8 // 全文索引分词长度限制3--11之间
}

func FullTextIndexNew() *FullTextIndex {
	return &FullTextIndex{ftlen: uint8(5)}
}
func (i *FullTextIndex) Set(ftlen int) error {
	if ftlen < 3 || ftlen > 11 {
		return fmt.Errorf("全文索引分词长度限制3--11之间")
	}
	i.ftlen = uint8(ftlen)
	return nil
}
func (i *FullTextIndex) GetLen() int {
	if i.ftlen == 0 {
		return 5
	}
	return int(i.ftlen)
}
func (i *FullTextIndex) Name() string {
	return "FullText"
}

// ------------------------------------------

// 字段索引类型
// 每个字段可以在不同索引中定义为不同的索引类型，高度灵活
type FieldIndexKind struct {
	field     string
	indexKind IndexKind
}

func FieldIndexKindNew(field string, kind IndexKind) *FieldIndexKind {
	return &FieldIndexKind{field: field, indexKind: kind}
}

// 设置值
func (fit *FieldIndexKind) Set(field string, kind IndexKind) {
	fit.field = field
	fit.indexKind = kind
}

// 获取索引类型
func (fit *FieldIndexKind) IndexKind() IndexKind {
	return fit.indexKind
}

// 获取索引字段
func (fit *FieldIndexKind) Field() string {
	return fit.field
}

// ------------------------------------------
// 断言索引类型函数
type AssertIndexKind = func(fieldIndexKind []*FieldIndexKind) IndexKind

// 默认断言索引类型函数
// 判断索引是何种类型,主键，普通索引，全文索引
func DefaultAssertIndexKind(fieldIndexKind []*FieldIndexKind) IndexKind {
	PrimaryKeyIndexCount := 0
	NormalIndexCount := 0
	FullTextIndexCount := 0
	for _, fit := range fieldIndexKind {
		switch fit.indexKind.Name() {
		case "Primary":
			PrimaryKeyIndexCount++
		case "Normal":
			NormalIndexCount++
		case "FullText":
			FullTextIndexCount++
		}
	}
	//优先1
	//规则是：有一个主键，则认为是主键索引
	if PrimaryKeyIndexCount > 0 {
		return &Primary{}
	}
	//优先2
	//规则是：有一个全文索引，则认为是全文索引
	if FullTextIndexCount > 0 {
		return &FullTextIndex{}
	}
	//优先3
	//规则是：剩下的是普通索引
	if NormalIndexCount > 0 {
		return &NormalIndex{}
	}
	return &NoIndex{}
}

// ------------------------------------------
// 全文索引遍历分词法
func GetFullTextToken(nr string, ftlen int) (tokens []string) {
	var knr string //, fid
	var ml, cl int
	var r, idxstr []rune
	r = []rune(nr)
	cl = len([]rune(nr))
	for cl > 0 {
		ml = min(cl, ftlen)
		idxstr = r[:ml]
		knr = string(idxstr)
		tokens = append(tokens, knr)
		r = r[1:]
		cl = len(r)
	}
	return
}

// ------------------------------------------
// 组织索引值
// 组合索引值，主键和索引是一样的，但是全文索引不同。
type JoinIndexValue func(fieldsBytes *map[string][]byte, fieldIndexKind []*FieldIndexKind, fields ...string) any

// 将字段对应的字节值拼接起来，用SPLIT分隔
func DefaultJoinIndexValue(fieldsBytes *map[string][]byte, fieldIndexKind []*FieldIndexKind, fields ...string) any {
	var indexValue []byte
	for i, field := range fields {
		if v, ok := (*fieldsBytes)[field]; !ok {
			return nil
		} else {
			indexValue = append(indexValue, v...)
			if i < len(fields)-1 {
				indexValue = append(indexValue, SPLIT...)
			}
		}
	}
	//pfx := fieldIndexKind[0].indexKind.Name()
	//indexValue = bytes.Join([][]byte{[]byte(pfx), indexValue}, []byte(SPLIT))
	return indexValue
}

// 将字段对应的字节值拼接起来，用SPLIT分隔
func DefaultJoinFullTextIndexValue(fieldsBytes *map[string][]byte, fieldIndexKind []*FieldIndexKind, fields ...string) any {
	var r [][]byte
	//var ftpxf []byte
	var fieldValue []byte
	var exists bool
	var curpfx [][]byte
	//curpfx = append(curpfx, fullTextPrefix)
	var isnil bool
	for _, field := range fields {
		// 获取字段的实际值
		fieldValue, exists = (*fieldsBytes)[field]
		if !exists {
			continue // 跳过不存在的字段
		}
		var isFullTextField bool
		ftlen := 5
		//组合全文索引时，全文索引字段和普通索引字段组合，需要判断那个字段是全文索引字段
		for _, fit := range fieldIndexKind {
			if fit.field == field {
				if _, isFullTextField = fit.indexKind.(*FullTextIndex); isFullTextField {
					//ftpxf = []byte(fit.indexKind.Name())
					break
				} else {
					isFullTextField = false
				}

				//isFullTextField = fit.indexKind.Name() == "FullText"
				ftlen = fit.indexKind.(*FullTextIndex).GetLen()
				//if isFullTextField {
				//ftpxf = []byte(fit.indexKind.Name())
				//break
				//}
			}
		}
		//该字段是否是全文索引字段
		switch isFullTextField {
		case true: // 全文索引字段
			// 将字段值转换为字符串，全文索引只支持字符串
			fieldStr := string(fieldValue)
			// 对字段值进行分词
			tokens := GetFullTextToken(fieldStr, ftlen)
			for _, token := range tokens {
				if token == "" {
					continue
				}
				//curpfx = append(curpfx, bytes.Join([][]byte{ftpxf, []byte(token)}, []byte(SPLIT)))
				curpfx = append(curpfx, []byte(token))
			}
		case false: // 普通索引字段
			//curpfx = append(curpfx, bytes.Join([][]byte{ftpxf, fieldValue}, []byte(SPLIT)))
			curpfx = append(curpfx, fieldValue)
		}
		//返回结果是否为空
		isnil = r == nil
		switch isnil {
		case true:
			//r = append(r, append([][]byte{}, ftpxf...)...)
			r = append(r, append([][]byte{}, curpfx...)...)
		case false: // 拼接当前索引前缀到结果中,一对多和多对一关系，多对多已经过滤，属于非法。
			for i, idx := range r {
				for _, pfx := range curpfx {
					var tidx []byte
					tidx = append(tidx, append([]byte{}, idx...)...)
					var tpfx []byte
					tpfx = append(tpfx, append([]byte{}, pfx...)...)
					tidx = bytes.Join([][]byte{tidx, tpfx}, []byte{})
					r[i] = tidx
				}
			}
		}
		curpfx = curpfx[:0]
		//ftpxf = ftpxf[:0]
	}
	return r
}

// ------------------------------------------
// 索引的结构体
type Index struct {
	set       []*FieldIndexKind // 主键字段列表，单主键长度为1，组合主键长度>1
	indexKind IndexKind         //可以手动设置索引类型，如果没有手动设置，则根据断言索引类型函数自动设置
	prefix    string            //索引前缀
	//AssertIndexKind        AssertIndexKind   //通过AssertIndexKind断言索引类型，返回IndexKind
	NormalIndexJoinValue   JoinIndexValue //普通索引值拼接函数
	FullTextIndexJoinValue JoinIndexValue //全文索引值拼接函数
}

func IndexNewDefault(fieldIndexKind []*FieldIndexKind) *Index {
	return &Index{
		set: fieldIndexKind,
		//AssertIndexKind:        DefaultAssertIndexKind,
		indexKind:              nil,
		NormalIndexJoinValue:   DefaultJoinIndexValue,
		FullTextIndexJoinValue: DefaultJoinFullTextIndexValue,
	}
}

// 判断索引是何种类型,主键，普通索引，全文索引
// 默认为第一个索引字段默认，可以合适大部分业务场景，只有特殊场景才需要手动设置索引类型
func (idx *Index) GetIndexKind(fieldIndexKind []*FieldIndexKind) IndexKind {
	if idx.indexKind != nil {
		return idx.indexKind
	}
	//idx.indexKind = idx.AssertIndexKind(fieldIndexKind)
	idx.indexKind = idx.set[0].indexKind
	return idx.indexKind
}
func (idx *Index) Name() string {
	fields := make([]string, 0, len(idx.set))
	for _, fik := range idx.set {
		fields = append(fields, fik.Field())
	}
	return strings.Join(fields, "-")
}
func (idx *Index) Len() int {
	return len(idx.set)
}

// 设置索引前缀
func (idx *Index) SetPrefix(prefix string) {
	idx.prefix = prefix
}

// 获取索引前缀
// 默认使用第一个字段的索引类型名称作为索引前缀，基本上大部分业务场景都可以满足需求
// 如果业务场景有特殊需求，则可以手动设置索引前缀
func (idx *Index) Prefix() string {
	if idx.prefix == "" {
		if idx.indexKind == nil {
			idx.prefix = idx.set[0].indexKind.Name()
		} else {
			idx.prefix = idx.indexKind.Name()
		}
	}
	return idx.prefix
}

// 默认普通索引值拼接，返回[]byte
func (idx *Index) IndexJoinValue(fieldsBytes *map[string][]byte, fields ...string) any {
	return idx.NormalIndexJoinValue(fieldsBytes, idx.set, fields...)
}

// 默认全文索引值拼接，返回[][]byte
func (idx *Index) FullTextJoinValue(fieldsBytes *map[string][]byte, fields ...string) any {
	return idx.FullTextIndexJoinValue(fieldsBytes, idx.set, fields...)
}

// ------------------------------------------

// 索引集的结构体
type Indexs struct {
	set           []*Index          // 主键字段列表，单主键长度为1，组合主键长度>1
	primaryFields []*FieldIndexKind // 主键字段列表，单主键长度为1，组合主键长度>1
}

// 主键必须先添加，才能优先匹配主键
func (is *Indexs) Add(index ...*Index) {
	is.set = append(is.set, index...)
}

func (is *Indexs) PrimaryFields() []*FieldIndexKind {
	if is.primaryFields != nil {
		return is.primaryFields
	}
	for _, idx := range is.set {
		kind := idx.GetIndexKind(idx.set)
		// 检查索引类型是否为Primary
		if _, ok := kind.(*Primary); ok {
			is.primaryFields = idx.set
			break // 找到主键索引后直接返回
		}
	}
	return is.primaryFields
}

// 匹配索引
// 当用户提交查询时，根据查询的字段，匹配索引集中的对应索引
func (is *Indexs) Match(fields []string) []*FieldIndexKind {
	Count := 0
	//主键必须先添加，才能优先匹配主键，优先级由用户手动添加的顺序决定
	for _, idx := range is.set {
		for _, field := range idx.set {
			if slices.Contains(fields, field.field) {
				Count++
			}
		}
		if Count == len(idx.set) {
			return idx.set
		}
	}
	return nil
}

// 数据库的添加，删除，修改等操作
// 匹配字段ufield ，用于记录修改某个字段时，只需要处理这些字段的索引即可。
// ins 表示是否是插入操作，true 表示put操作，false 表示delete操作。
func (is *Indexs) Joins(fieldsBytes *map[string][]byte, ufield ...string) (rs *IndexJoinValue) {
	rs = DefaultIndexJoinValuePool.Get()
	// 遍历索引集
	var indexValue any
	var indexValues any
	var indexKind IndexKind

	for _, idx := range is.set {
		for _, fik := range idx.set {
			if len(ufield) > 0 { //更新模式
				if !slices.Contains(ufield, fik.Field()) { //非更新字段，跳过
					break
				}
			}
		}
		fields := make([]string, 0, len(idx.set))
		for _, fik := range idx.set {
			fields = append(fields, fik.Field())
		}
		pkpfx := idx.Prefix()
		indexKind = idx.GetIndexKind(idx.set)
		switch indexKind.(type) {
		case *Primary:
			indexValue = idx.IndexJoinValue(fieldsBytes, fields...)
			rs.PrimaryIDValue = indexValue.([]byte)
			// 添加索引前缀
			rs.PrimaryValue = bytes.Join([][]byte{[]byte(pkpfx), rs.PrimaryIDValue}, []byte(SPLIT))
			rs.PrimaryLen = len(idx.set)

		case *FullTextIndex:
			indexValues = idx.FullTextJoinValue(fieldsBytes, fields...)
			fulltextvalue := indexValues.([][]byte)
			// 全文索引值拼接，添加索引前缀
			for _, v := range fulltextvalue {
				pv := bytes.Join([][]byte{[]byte(pkpfx), v}, []byte(SPLIT))
				rs.OtherValues = append(rs.OtherValues, append([]byte(nil), pv...))
			}
			continue

		case *NormalIndex:
			indexValue = idx.IndexJoinValue(fieldsBytes, fields...)
			// 添加索引前缀
			rs.OtherValues = append(rs.OtherValues, append([]byte(nil), bytes.Join([][]byte{[]byte(pkpfx), indexValue.([]byte)}, []byte(SPLIT))...))
		case *NoIndex:
			rs.OtherValues = append(rs.OtherValues, nil)
		default:
			continue
		}
	}
	fmt.Printf("rs.PrimaryLen: %v\n", rs.PrimaryLen)
	fmt.Printf("rs.PrimaryValue: %v\n", string(rs.PrimaryValue))
	fmt.Printf("rs.PrimaryIDValue: %v\n", string(rs.PrimaryIDValue))
	for _, v := range rs.OtherValues {
		fmt.Printf("v: %v\n", string(v))
	}
	return
}
